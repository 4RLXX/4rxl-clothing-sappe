--==================================================

local function refreshSavedParts()

    for _,child in ipairs(list:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    countLabel.Text = #savedParts .. " SAVED"

    for index,entry in ipairs(savedParts) do

        local part = entry.part

        local row = Instance.new("Frame")
        row.Name = "SavedPart_"..index
        row.Size = UDim2.new(1,0,0,55)
        row.BackgroundColor3 = Color3.fromRGB(48,48,48)
        row.BorderSizePixel = 0
        row.LayoutOrder = index
        row.Parent = list

        Instance.new("UICorner",row).CornerRadius = UDim.new(0,6)

        local name = Instance.new("TextLabel")
        name.Size = UDim2.new(1,-10,0,18)
        name.Position = UDim2.fromOffset(5,2)
        name.BackgroundTransparency = 1
        name.Text = entry.name
        name.TextColor3 = Color3.new(1,1,1)
        name.Font = Enum.Font.GothamBold
        name.TextSize = 10
        name.TextXAlignment = Enum.TextXAlignment.Left
        name.TextTruncate = Enum.TextTruncate.AtEnd
        name.Parent = row

        local status = Instance.new("TextLabel")
        status.Size = UDim2.new(1,-10,0,13)
        status.Position = UDim2.fromOffset(5,20)
        status.BackgroundTransparency = 1

        if part and part:IsDescendantOf(workspace) then
            status.Text = "X: "..math.floor(part.Position.X)
                .."  Y: "..math.floor(part.Position.Y)
                .."  Z: "..math.floor(part.Position.Z)
        else
            status.Text = "PART UNAVAILABLE"
        end

        status.TextColor3 = Color3.fromRGB(175,175,175)
        status.Font = Enum.Font.Gotham
        status.TextSize = 8
        status.TextXAlignment = Enum.TextXAlignment.Left
        status.Parent = row

        -- TELEPORT BUTTON
        local tp = Instance.new("TextButton")
        tp.Size = UDim2.fromOffset(65,18)
        tp.Position = UDim2.new(0,5,1,-20)
        tp.BackgroundColor3 = Color3.fromRGB(45,145,85)
        tp.Text = "TELEPORT"
        tp.TextColor3 = Color3.new(1,1,1)
        tp.Font = Enum.Font.GothamBold
        tp.TextSize = 8
        tp.Parent = row

        Instance.new("UICorner",tp).CornerRadius = UDim.new(0,4)

        tp.Activated:Connect(function()

            if not part or not part:IsDescendantOf(workspace) then
                status.Text = "PART UNAVAILABLE"
                return
            end

            local character = player.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")

            if root then
                root.CFrame = part.CFrame * CFrame.new(
                    0,part.Size.Y/2 + 4,0
                )
            end
        end)

        -- DELETE BUTTON
        local delete = Instance.new("TextButton")
        delete.Size = UDim2.fromOffset(55,18)
        delete.Position = UDim2.new(1,-60,1,-20)
        delete.BackgroundColor3 = Color3.fromRGB(160,55,55)
        delete.Text = "DELETE"
        delete.TextColor3 = Color3.new(1,1,1)
        delete.Font = Enum.Font.GothamBold
        delete.TextSize = 8
        delete.Parent = row

        Instance.new("UICorner",delete).CornerRadius = UDim.new(0,4)

        delete.Activated:Connect(function()

            table.remove(savedParts,index)
            refreshSavedParts()

        end)
    end
end

