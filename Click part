-- SELECT MODE
selectButton.Activated:Connect(function()

    selecting = not selecting

    if selecting then
        selectButton.Text = "TAP ON A PART..."
        selectButton.BackgroundColor3 = Color3.fromRGB(180,110,40)
    else
        selectButton.Text = "SELECT PART"
        selectButton.BackgroundColor3 = Color3.fromRGB(55,110,180)
    end

end)

-- PART SELECTION
local function selectTarget(target)

    if not selecting then return end

    if not target or not target:IsA("BasePart") then
        return
    end

    selectedPart = target
    selecting = false

    selectButton.Text = "SELECT PART"
    selectButton.BackgroundColor3 = Color3.fromRGB(55,110,180)

    partName.Text = target.Name

    local p = target.Position

    coordinates.Text = string.format(
        "X: %.1f | Y: %.1f | Z: %.1f",
        p.X,p.Y,p.Z
    )

end

-- PC SELECTION
local mouse = player:GetMouse()

mouse.Button1Down:Connect(function()

    if not selecting then return end

    selectTarget(mouse.Target)

end)

-- MOBILE SELECTION
UserInputService.TouchTap:Connect(function(touchPositions, gameProcessed)

    if not selecting then return end
    if gameProcessed then return end

    local camera = workspace.CurrentCamera
    if not camera then return end

    local position = touchPositions[1]
    if not position then return end

    local ray = camera:ViewportPointToRay(
        position.X,
        position.Y
    )

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {
        player.Character,
        gui
    }

    local result = workspace:Raycast(
        ray.Origin,
        ray.Direction * 1000,
        params
    )

    if result then
        selectTarget(result.Instance)
    end

end)

-- TELEPORT
teleportButton.Activated:Connect(function()

    if not selectedPart or not selectedPart:IsDescendantOf(workspace) then
        partName.Text = "Select a valid Part!"
        return
    end

    local character = player.Character
    if not character then return end

    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local destination = selectedPart.CFrame * CFrame.new(
        0,
        selectedPart.Size.Y / 2 + 4,
        0
    )

    root.CFrame = destination

end)

-- CLOSE
closeButton.Activated:Connect(function()
    gui:Destroy()
end)

