--==================================================
-- SELECT PART
--==================================================

local function selectTarget(target)

    if not selecting then return end

    if not target or not target:IsA("BasePart") then
        return
    end

    selectedPart = target
    selecting = false

    selectButton.Text = "SELECT PART"
    selectButton.BackgroundColor3 = Color3.fromRGB(55,110,180)

    partName.Text = target.Name

    local p = target.Position

    coordinates.Text = string.format(
        "X: %.1f | Y: %.1f | Z: %.1f",
        p.X,p.Y,p.Z
    )
end

selectButton.Activated:Connect(function()

    selecting = not selecting

    if selecting then
        selectButton.Text = "TAP ON A PART..."
        selectButton.BackgroundColor3 = Color3.fromRGB(180,110,40)
    else
        selectButton.Text = "SELECT PART"
        selectButton.BackgroundColor3 = Color3.fromRGB(55,110,180)
    end
end)

-- PC
mouse.Button1Down:Connect(function()

    if not selecting then return end

    selectTarget(mouse.Target)

end)

-- MOBILE
UIS.TouchTap:Connect(function(positions,gameProcessed)

    if not selecting or gameProcessed then return end

    local camera = workspace.CurrentCamera
    if not camera then return end

    local position = positions[1]
    if not position then return end

    local ray = camera:ScreenPointToRay(
        position.X,
        position.Y
    )

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {
        player.Character,
        gui
    }

    local result = workspace:Raycast(
        ray.Origin,
        ray.Direction * 1000,
        params
    )

    if result then
        selectTarget(result.Instance)
    end

end)

--==================================================
-- SAVE PART
--==================================================

saveButton.Activated:Connect(function()

    if not selectedPart or not selectedPart:IsDescendantOf(workspace) then
        partName.Text = "SELECT A PART FIRST!"
        return
    end

    -- Avoid duplicates
    for _,entry in ipairs(savedParts) do

        if entry.part == selectedPart then
            partName.Text = "ALREADY SAVED!"
            return
        end
    end

    table.insert(savedParts,{
        part = selectedPart,
        name = selectedPart.Name
    })

    partName.Text = "PART SAVED!"

    refreshSavedParts()
end)

