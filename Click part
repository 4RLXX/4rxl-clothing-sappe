
--==================================================
-- TELEPORT TESTER MOBILE + PC
-- 100% LOCALSCRIPT
--==================================================

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local mouse = player:GetMouse()

local selectedPart = nil
local selecting = false

local isMobile = UserInputService.TouchEnabled

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "TeleportTesterGUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

-- MAIN FRAME
local main = Instance.new("Frame")
main.Size = isMobile and UDim2.fromOffset(290,310) or UDim2.fromOffset(400,390)
main.Position = UDim2.new(0.5,0,0.5,0)
main.AnchorPoint = Vector2.new(0.5,0.5)
main.BackgroundColor3 = Color3.fromRGB(24,24,24)
main.BorderSizePixel = 0
main.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0,15)
corner.Parent = main

-- TITLE
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1,0,0,42)
title.BackgroundColor3 = Color3.fromRGB(35,35,35)
title.Text = "TELEPORT TESTER"
title.TextColor3 = Color3.new(1,1,1)
title.Font = Enum.Font.GothamBold
title.TextSize = 16
title.Parent = main

local titleCorner = Instance.new("UICorner")
titleCorner.CornerRadius = UDim.new(0,12)
titleCorner.Parent = title

-- BUTTON FUNCTION
local function createButton(name,text,y,height,color)
    local button = Instance.new("TextButton")
    button.Name = name
    button.Size = UDim2.new(1,-30,0,height)
    button.Position = UDim2.fromOffset(15,y)
    button.BackgroundColor3 = color
    button.Text = text
    button.TextColor3 = Color3.new(1,1,1)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 13
    button.BorderSizePixel = 0
    button.Parent = main

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0,8)
    c.Parent = button

    return button
end

-- SELECT
local selectButton = createButton(
    "SelectPart",
    "SELECT PART",
    55,
    40,
    Color3.fromRGB(55,110,180)
)

-- PREVIEW
local preview = Instance.new("Frame")
preview.Size = UDim2.new(1,-30,0,100)
preview.Position = UDim2.fromOffset(15,110)
preview.BackgroundColor3 = Color3.fromRGB(38,38,38)
preview.BorderSizePixel = 0
preview.Parent = main

local previewCorner = Instance.new("UICorner")
previewCorner.CornerRadius = UDim.new(0,10)
previewCorner.Parent = preview

local partName = Instance.new("TextLabel")
partName.Size = UDim2.new(1,-10,0,35)
partName.Position = UDim2.fromOffset(5,8)
partName.BackgroundTransparency = 1
partName.Text = "No Part Selected"
partName.TextColor3 = Color3.new(1,1,1)
partName.Font = Enum.Font.GothamBold
partName.TextSize = 13
partName.TextWrapped = true
partName.Parent = preview

local coordinates = Instance.new("TextLabel")
coordinates.Size = UDim2.new(1,-10,0,35)
coordinates.Position = UDim2.fromOffset(5,52)
coordinates.BackgroundTransparency = 1
coordinates.Text = "X: - | Y: - | Z: -"
coordinates.TextColor3 = Color3.fromRGB(180,180,180)
coordinates.Font = Enum.Font.Gotham
coordinates.TextSize = 11
coordinates.Parent = preview

-- TELEPORT
local teleportButton = createButton(
    "Teleport",
    "TELEPORT",
    225,
    38,
    Color3.fromRGB(45,145,85)
)

-- CLOSE
local closeButton = createButton(
    "Close",
    "CLOSE",
    270,
    28,
    Color3.fromRGB(160,55,55)
)

-- SELECT MODE
selectButton.Activated:Connect(function()
    selecting = not selecting

    if selecting then
        selectButton.Text = "CLICK ON A PART..."
        selectButton.BackgroundColor3 = Color3.fromRGB(180,110,40)
    else
        selectButton.Text = "SELECT PART"
        selectButton.BackgroundColor3 = Color3.fromRGB(55,110,180)
    end
end)

-- SELECT PART (PC + MOBILE)
mouse.Button1Down:Connect(function()
    if not selecting then return end

    local target = mouse.Target

    if target and target:IsA("BasePart") then
        selectedPart = target
        selecting = false

        selectButton.Text = "SELECT PART"
        selectButton.BackgroundColor3 = Color3.fromRGB(55,110,180)

        partName.Text = "Selected: "..target.Name

        local p = target.Position

        coordinates.Text = string.format(
            "X: %.1f | Y: %.1f | Z: %.1f",
            p.X,p.Y,p.Z
        )
    end
end)

-- TELEPORT
teleportButton.Activated:Connect(function()
    if not selectedPart or not selectedPart.Parent then
        partName.Text = "Please select a Part!"
        return
    end

    local character = player.Character
    if not character then return end

    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    root.CFrame = selectedPart.CFrame + Vector3.new(
        0,
        selectedPart.Size.Y/2 + 4,
        0
    )
end)

-- CLOSE
closeButton.Activated:Connect(function()
    gui:Destroy()
end)

print("Teleport Tester Mobile loaded!")
